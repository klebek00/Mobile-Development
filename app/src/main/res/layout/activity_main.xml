<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BCE8ECF0"
    tools:context=".MainActivity">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="600dp"
        android:textColorHint="@color/back"
        app:boxBackgroundColor="@color/main"
        app:boxStrokeColor="@color/main"
        app:counterTextColor="@color/back"
        app:cursorColor="@color/back"
        app:endIconTint="@color/white"
        app:helperTextTextColor="@color/back"
        app:hintTextColor="@color/back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderTextColor="@color/back"
        app:prefixTextColor="@color/back"

        app:suffixTextColor="@color/back">


        <AutoCompleteTextView
            android:id="@+id/autoCompleteTextView"
            android:layout_width="129dp"
            android:layout_height="57dp"
            android:layout_weight="1"
            android:fontFamily="@font/secular_one"
            android:inputType="none"
            android:shadowColor="#C0E0F0"
            android:text="200 ml"
            android:textColor="@color/white"
            android:textColorHighlight="#C0E0F0"
            android:textColorHint="#C0E0F0"
            android:textColorLink="@color/white"
            app:dropDownBackgroundTint="@color/back"
            app:simpleItemSelectedColor="#C0E0F0"
            app:simpleItemSelectedRippleColor="#C0E0F0" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/button7"
        style="@style/Widget.Material3.Button"
        android:layout_width="201dp"
        android:layout_height="84dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="125dp"
        android:backgroundTint="@color/main"
        android:fontFamily="@font/secular_one"
        android:text="+ DRINK"
        android:textColorLink="@color/black"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_bar"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp"
        android:layout_marginBottom="60dp"
        android:fontFamily="@font/secular_one"
        android:text="0.0 L"
        android:textSize="48sp"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="@style/CircularDeterminateProgressBar"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="150dp"
        android:layout_marginBottom="90dp"
        android:indeterminateOnly="false"
        android:progress="0"
        android:progressDrawable="@drawable/circle"
        android:rotation="-90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:progress="60" />

    <TextView
        android:id="@+id/text_view_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/secular_one"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        app:layout_constraintBottom_toBottomOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="@+id/progress_bar"
        app:layout_constraintStart_toStartOf="@+id/progress_bar"
        app:layout_constraintTop_toTopOf="@+id/progress_bar"
        tools:text="60%" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/button11"
            style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/button_pressed"
            android:clickable="false"
            android:text="Today"
            tools:ignore="MissingConstraints" />

        <Button
            android:id="@+id/button12"
            style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/main"
            android:text="History"
            tools:ignore="MissingConstraints" />

        <Button
            android:id="@+id/button13"
            style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/main"
            android:text="Me"
            tools:ignore="MissingConstraints" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>